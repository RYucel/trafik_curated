# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id_here

# Database
DATABASE_URL=file:./db/kktc_traffic.db
